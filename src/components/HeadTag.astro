---
import Font from "astro/components/Font.astro";

const { route, title, description } = Astro.props;
---

<head>
    <Font cssVariable="--pretendard" />
    <meta charset="UTF-8" />
    <title>{title}</title>

    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <meta name="title" content={title} />
    <meta name="description" content={description} />
    <meta name="author" content="Pro203S" />

    <meta http-equiv="refresh" content="30" />

    <meta property="og:title" content={title} />
    <meta property="og:url" content={`https://blog.pro203s.kr${route}`} />
    <meta property="og:type" content="blog" />
    <meta property="og:image" content="/image.png" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />

    <meta
        name="twitter:card"
        content="summary"
    />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="/image.png" />
</head>
